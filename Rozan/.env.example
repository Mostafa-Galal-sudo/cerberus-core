# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: comma-separated webhook URLs that receive alert JSON pushes
WEBHOOK_URLS=

# MQTT gateway
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Backend
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# LLM models (optional overrides)
DEEPSEEK_MODEL=deepseek-chat
GROQ_MODEL=llama-3.3-70b-versatile
